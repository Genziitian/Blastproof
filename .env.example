# Copy to .env and fill in. Never commit .env.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
COMPANIES=a,b
# normal = 30 s lease / 10 s heartbeat; demo = 6 s / 2 s (say so on screen when recording)
TIMING_PROFILE=normal
# Optional LLM (any OpenAI-compatible endpoint). Leave LLM_MODEL empty to run fully
# deterministic: the rule-based planner and preference parser take over.
# Local and free with Ollama:   ollama pull gemma4:e4b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=
