# Copy to .env and fill in. Never commit .env.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
COMPANIES=a,b
# normal = 30 s lease / 10 s heartbeat; demo = 6 s / 2 s (say so on screen when recording)
TIMING_PROFILE=normal
# LLM (any OpenAI-compatible endpoint). Leave LLM_MODEL empty to run fully
# deterministic: the rule-based planner and preference parser take over.
#
# Project default: Gemini free tier. Get a key at https://aistudio.google.com/apikey
# and check your model ID and limits at https://aistudio.google.com/rate-limit
# (free tier is roughly 10 requests/minute; 6.5 s spacing stays under it).
# Free-tier prompts may be used by Google to improve its products: only synthetic
# data goes to the model here.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=
LLM_API_KEY=
LLM_MIN_INTERVAL_S=6.5
LLM_MAX_RETRIES=4
# Reuse answers on reruns (accuracy only; never report timings from a cached run).
LLM_CACHE_DIR=            # e.g. .llm-cache (git-ignored)
#
# Fully local alternative:  ollama pull gemma4:e4b, then
#   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=gemma4:e4b  LLM_MIN_INTERVAL_S=0
